APP_ENV=local
APP_DEBUG=1
APP_NAME="VDBS Portal"
APP_BASE_URL=http://vdbs-portal.localhost

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=vdbs_sys
DB_USER=vdbs_sys
DB_PASS=
DB_CHARSET=utf8mb4# --- Mailversand (Basis, Issue #2 Schritt 1) ---
# Bleibt MAIL_HOST leer, wird automatisch der NullMailer verwendet
# (Mails werden nach var/log/mail.log protokolliert statt versendet).
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@vdbs-portal.example.org
MAIL_FROM_NAME="VDBS Portal"
