<?php

declare(strict_types=1);

$root = dirname(__DIR__, 2);

/**
 * Entfernt einzeilige //-Kommentare und einfache Blockkommentare für statische Checks.
 */
function stripCommentsForRuntimeCheck(string $content): string
{
    $content = preg_replace('~/\*.*?\*/~s', '', $content) ?? $content;
    $lines = preg_split('/\R/', $content) ?: [];

    $clean = [];
    foreach ($lines as $line) {
        $trim = trim($line);
        if ($trim === '' || str_starts_with($trim, '//') || str_starts_with($trim, '*')) {
            $clean[] = '';
            continue;
        }
        $clean[] = $line;
    }

    return implode("\n", $clean);
}

$controllerFiles = [
    'src/Http/Controller/Verwaltung/VerwaltungController.php',
    'src/Http/Controller/Verwaltung/PersonenController.php',
    'src/Http/Controller/Verwaltung/AuditLogController.php',
    'src/Http/Controller/Verwaltung/EntityAuditController.php',
    'src/Http/Controller/Verwaltung/DatenschutzController.php',
    'src/Http/Controller/Verwaltung/EinladungenController.php',
    'src/Http/Controller/Verwaltung/SchulverzeichnisController.php',
    'src/Http/Controller/Verwaltung/GruppenController.php',
    'src/Http/Controller/Verwaltung/BerechtigungenController.php',
];

$bad = [];

foreach ($controllerFiles as $relative) {
    $path = $root . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $relative);
    if (!is_file($path)) {
        continue;
    }

    $raw = file_get_contents($path);
    if ($raw === false) {
        $bad[] = "{$relative}: konnte nicht gelesen werden";
        continue;
    }

    $content = stripCommentsForRuntimeCheck($raw);
    $lines = preg_split('/\R/', $content) ?: [];

    foreach ($lines as $idx => $line) {
        $lineNo = $idx + 1;
        if (str_contains($line, 'requirePageGroupAccess(')
            || str_contains($line, 'canAccessPageGroup(')
            || str_contains($line, 'currentUserCanAccessPageGroup(')
            || str_contains($line, 'pt_page_groups')
            || str_contains($line, 'pt_permission_group_page_group_access')) {
            $bad[] = sprintf('%s:%d: %s', $relative, $lineNo, trim($line));
        }
    }
}

$routesRelative = 'config/routes.php';
$routesPath = $root . DIRECTORY_SEPARATOR . 'config' . DIRECTORY_SEPARATOR . 'routes.php';
if (is_file($routesPath)) {
    $raw = file_get_contents($routesPath);
    if ($raw === false) {
        $bad[] = 'config/routes.php: konnte nicht gelesen werden';
    } else {
        $content = stripCommentsForRuntimeCheck($raw);
        $lines = preg_split('/\R/', $content) ?: [];

        $oldImports = [];
        foreach ($lines as $line) {
            if (preg_match('/^\s*use\s+App\\\\Http\\\\Controller\\\\Verwaltung\\\\([A-Za-z0-9_]+)(?:\s+as\s+([A-Za-z0-9_]+))?\s*;\s*$/', $line, $m)) {
                $alias = $m[2] ?? $m[1];
                $oldImports[$alias] = 'App\\Http\\Controller\\Verwaltung\\' . $m[1];
            }
        }

        foreach ($lines as $idx => $line) {
            $trim = trim($line);
            if (!str_contains($trim, 'new Route(')) {
                continue;
            }

            if (str_contains($line, 'App\\Http\\Controller\\Verwaltung\\GruppenController::class')
                || str_contains($line, 'App\\Http\\Controller\\Verwaltung\\BerechtigungenController::class')) {
                $bad[] = sprintf('%s:%d: alter Rechteverwaltungscontroller aktiv: %s', $routesRelative, $idx + 1, trim($line));
                continue;
            }

            foreach (['GruppenController', 'BerechtigungenController'] as $controllerAlias) {
                if (isset($oldImports[$controllerAlias]) && str_contains($line, $controllerAlias . '::class')) {
                    $bad[] = sprintf('%s:%d: alter Rechteverwaltungscontroller aktiv: %s', $routesRelative, $idx + 1, trim($line));
                }
            }
        }
    }
}

if ($bad !== []) {
    echo "Aktive PageGroup-/Legacy-Runtime-Treffer gefunden:\n";
    foreach ($bad as $entry) {
        echo " - {$entry}\n";
    }
    exit(1);
}

echo "OK: Keine aktiven PageGroup-Laufzeitaufrufe in bekannten Routen/Controllern gefunden.\n";
