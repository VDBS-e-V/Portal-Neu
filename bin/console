#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use App\Bootstrap\Routes;

$command = $argv[1] ?? '';

if ($command === 'routes') {
    foreach (Routes::load() as $route) {
        echo sprintf("%s %s -> %s::%s\n", $route->method, $route->path, $route->controller, $route->action);
    }

    exit(0);
}

fwrite(STDERR, "Usage: php bin/console routes\n");
exit(1);