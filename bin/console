#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use App\Bootstrap\Routes;

// Load project .env for CLI (so getenv() picks up DB_* variables)
$root = dirname(__DIR__);
$envFile = $root . '/.env';
if (is_file($envFile)) {
    loadEnvFile($envFile);
}

$command = $argv[1] ?? '';

if ($command === 'routes') {
    foreach (Routes::load() as $route) {
        echo sprintf("%s %s -> %s::%s\n", $route->method, $route->path, $route->controller, $route->action);
    }

    exit(0);
}

if ($command === 'migrate' || $command === 'migrate:status' || $command === 'seed') {
    // Lazy-load functions and execute requested action
    if ($command === 'migrate') {
        runMigrate();
        exit(0);
    }

    if ($command === 'migrate:status') {
        runMigrateStatus();
        exit(0);
    }

    if ($command === 'seed') {
        runSeed();
        exit(0);
    }
}

fwrite(STDERR, "Usage: php bin/console routes|migrate|migrate:status|seed\n");
exit(1);

function getPdo(): PDO
{
    $host = getenv('DB_HOST') ?: '127.0.0.1';
    $port = getenv('DB_PORT') ?: '3306';
    $db = getenv('DB_NAME') ?: '';
    $user = getenv('DB_USER') ?: 'root';
    $pass = getenv('DB_PASS') ?: '';

    if (empty($db)) {
        fwrite(STDERR, "Environment variable DB_NAME is required.\n");
        exit(1);
    }

    $dsn = sprintf('mysql:host=%s;port=%s;dbname=%s;charset=utf8mb4', $host, $port, $db);
    try {
        $pdo = new PDO($dsn, $user, $pass, [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
    } catch (PDOException $e) {
        fwrite(STDERR, "Failed to connect to DB: " . $e->getMessage() . "\n");
        exit(1);
    }

    return $pdo;
}

function listSqlFiles(string $dir): array
{
    if (!is_dir($dir)) {
        return [];
    }

    $all = array_filter(scandir($dir), function ($f) use ($dir) {
        return is_file($dir . DIRECTORY_SEPARATOR . $f) && substr($f, -4) === '.sql';
    });
    sort($all, SORT_STRING);
    return array_values($all);
}

function runMigrate(): void
{
    $pdo = getPdo();
    $dir = dirname(__DIR__) . '/database/migrations';
    $files = listSqlFiles($dir);

    // get applied migrations
    $applied = [];
    try {
        $stmt = $pdo->query('SELECT migration FROM `__migrations`');
        $applied = $stmt->fetchAll(PDO::FETCH_COLUMN, 0) ?: [];
    } catch (PDOException $e) {
        // migrations table may not exist yet
        $applied = [];
    }

    // determine batch
    $batch = 1;
    try {
        $row = $pdo->query('SELECT COALESCE(MAX(batch), 0) FROM `__migrations`')->fetchColumn();
        $batch = ((int)$row) + 1;
    } catch (PDOException $e) {
        $batch = 1;
    }

    foreach ($files as $file) {
        if (in_array($file, $applied, true)) {
            echo "Skipped: $file\n";
            continue;
        }

        $path = $dir . DIRECTORY_SEPARATOR . $file;
        echo "Running: $file\n";
        $sql = file_get_contents($path);
        if ($sql === false) {
            fwrite(STDERR, "Failed to read $path\n");
            exit(1);
        }

        try {
            $pdo->beginTransaction();

            // attempt to execute the SQL; split statements by semicolon+newline to be safer
            $stmts = preg_split('/;\s*\n/', $sql);
            foreach ($stmts as $s) {
                $s = trim($s);
                if ($s === '') {
                    continue;
                }
                $pdo->exec($s);
            }

            // ensure migrations table exists before inserting (it will after running 0000)
            $pdo->prepare('INSERT INTO `__migrations` (migration, batch) VALUES (?, ?)')->execute([$file, $batch]);

            // Commit only if a transaction is still active. Some DDL statements (CREATE TABLE)
            // cause implicit commits in MySQL and calling commit() afterwards throws
            // "There is no active transaction". Handle that gracefully.
            try {
                if ($pdo->inTransaction()) {
                    $pdo->commit();
                }
            } catch (PDOException $commitEx) {
                // If the commit failed because there's no active transaction, ignore it.
                if (strpos($commitEx->getMessage(), 'There is no active transaction') === false) {
                    throw $commitEx;
                }
            }

            echo "Applied: $file\n";
        } catch (Exception $e) {
            if ($pdo->inTransaction()) {
                $pdo->rollBack();
            }
            fwrite(STDERR, "Failed to apply $file: " . $e->getMessage() . "\n");
            exit(1);
        }
    }

    echo "Migrations complete.\n";
}

function runMigrateStatus(): void
{
    $pdo = getPdo();
    $dir = dirname(__DIR__) . '/database/migrations';
    $files = listSqlFiles($dir);

    $applied = [];
    try {
        $rows = $pdo->query('SELECT migration, batch, ran_at FROM `__migrations`')->fetchAll(PDO::FETCH_ASSOC);
        foreach ($rows as $r) {
            $applied[$r['migration']] = $r;
        }
    } catch (PDOException $e) {
        // no migrations table yet
        $applied = [];
    }

    foreach ($files as $file) {
        if (isset($applied[$file])) {
            $info = $applied[$file];
            echo sprintf("[X] %s (batch=%s, ran_at=%s)\n", $file, $info['batch'], $info['ran_at']);
        } else {
            echo sprintf("[ ] %s\n", $file);
        }
    }
}

function runSeed(): void
{
    $pdo = getPdo();
    $dir = dirname(__DIR__) . '/database/seeds';
    $files = listSqlFiles($dir);

    if (empty($files)) {
        echo "No seed files found.\n";
        return;
    }

    foreach ($files as $file) {
        $path = $dir . DIRECTORY_SEPARATOR . $file;
        echo "Seeding: $file\n";
        $sql = file_get_contents($path);
        if ($sql === false) {
            fwrite(STDERR, "Failed to read $path\n");
            exit(1);
        }

        // Replace placeholder user UUID if present
        if (strpos($sql, '<USER_UUID>') !== false) {
            try {
                $hex = bin2hex(random_bytes(16));
            } catch (Exception $e) {
                // fallback to using uniqid-based hex
                $hex = str_replace('.', '', uniqid('', true));
                $hex = substr(str_pad($hex, 32, '0'), 0, 32);
            }
            $sql = str_replace('<USER_UUID>', $hex, $sql);
        }

        // Replace placeholder bcrypt hash if present
        if (strpos($sql, '<BCRYPT_HASH>') !== false) {
            $password = getenv('SEED_ADMIN_PASSWORD');
            if ($password === false || $password === '') {
                fwrite(STDOUT, "Enter admin password for seed (will be hashed): ");
                $password = trim(fgets(STDIN));
                if ($password === '') {
                    fwrite(STDERR, "No password provided; aborting seed.\n");
                    exit(1);
                }
            }
            $hash = password_hash($password, PASSWORD_DEFAULT);
            $sql = str_replace('<BCRYPT_HASH>', addslashes($hash), $sql);
        }

        try {
            $pdo->beginTransaction();
            $stmts = preg_split('/;\s*\n/', $sql);
            foreach ($stmts as $s) {
                $s = trim($s);
                if ($s === '') {
                    continue;
                }
                $pdo->exec($s);
            }
            try {
                if ($pdo->inTransaction()) {
                    $pdo->commit();
                }
            } catch (PDOException $commitEx) {
                if (strpos($commitEx->getMessage(), 'There is no active transaction') === false) {
                    throw $commitEx;
                }
            }
            echo "Seeded: $file\n";
        } catch (Exception $e) {
            if ($pdo->inTransaction()) {
                $pdo->rollBack();
            }
            fwrite(STDERR, "Failed to seed $file: " . $e->getMessage() . "\n");
            exit(1);
        }
    }

    echo "Seeding complete.\n";
}

function loadEnvFile(string $envFile): void
{
    $lines = @file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    if ($lines === false) {
        return;
    }

    foreach ($lines as $line) {
        $line = trim($line);
        if ($line === '' || str_starts_with($line, '#')) {
            continue;
        }

        $position = strpos($line, '=');
        if ($position === false) {
            continue;
        }

        $key = trim(substr($line, 0, $position));
        $value = trim(substr($line, $position + 1));

        if (
            (str_starts_with($value, '"') && str_ends_with($value, '"')) ||
            (str_starts_with($value, "'") && str_ends_with($value, "'"))
        ) {
            $value = substr($value, 1, -1);
        }

        if (getenv($key) === false) {
            putenv($key . '=' . $value);
            $_ENV[$key] = $value;
        }
    }
}