<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

$cmd = $argv[1] ?? 'help';

switch ($cmd) {
    case 'help':
    default:
        echo "Commands:\n";
        echo "  help            Show this help\n";
        echo "  routes          List routes (reads config/routes.php)\n";
        exit(0);

    case 'routes':
        $routes = require dirname(__DIR__) . '/config/routes.php';
        foreach ($routes as $r) {
            [$method, $path, $handler] = $r;
            echo sprintf("%-6s %s -> %s::%s\n", $method, $path, $handler[0], $handler[1]);
        }
        exit(0);
}